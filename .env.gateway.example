# Optional Gateway gateway. Keep in .env.gateway and outside Git.
GATEWAY_ENABLED=true
GATEWAY_PROVIDER_BASE_URL=https://api.openai.com/v1
GATEWAY_ALLOWED_HOSTS=api.openai.com
GATEWAY_PROVIDER_API_KEY=REPLACE_ME
GATEWAY_MODEL=gpt-4.1-mini
# EXAMPLE rates ONLY; verify your provider and model's actual applicable pricing.
GATEWAY_PRICE_INPUT_USD_PER_1M=0.40
GATEWAY_PRICE_CACHED_USD_PER_1M=0.10
GATEWAY_PRICE_OUTPUT_USD_PER_1M=1.60
GATEWAY_DAILY_LIMIT_USD=2.00
# Each request holds budget until provider usage is recorded; not a billing guarantee.
GATEWAY_CALL_HOLD_USD=0.10
