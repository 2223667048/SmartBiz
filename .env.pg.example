# LOCAL DEMO ONLY. Place in .env.pg (not .env). Use distinct long alphanumeric passwords.
# Avoid URL-reserved characters in local configuration; production should URL-encode credentials or use secret management.
PG_OWNER_PASSWORD=CHANGE_TO_DIFFERENT_RANDOM_ALNUM_40_CHARS
PG_APP_PASSWORD=CHANGE_TO_DIFFERENT_RANDOM_ALNUM_40_CHARS
PG_WORKER_PASSWORD=CHANGE_TO_DIFFERENT_RANDOM_ALNUM_40_CHARS
