# First run: mock without any LLM cost. Switch to langflow after your flow is working.
AGENT_MODE=mock
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
SMARTBIZ_DB_PATH=./data/smartbiz.sqlite3
# REQUIRED to enable admin API; change to a long random secret (never commit .env).
ADMIN_API_KEY=
# Used by the Langflow container if using docker compose.
LANGFLOW_SUPERUSER_PASSWORD=change-this-to-a-strong-password

# Lesson 4. Set both keys to long, distinct random strings before enabling KB.
KB_SERVICE_KEY=
# demo: deterministic character hashing (NOT semantic embeddings); openai: real embeddings
RAG_EMBEDDING_MODE=demo
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Optional for providers/models that support dimensions; blank = provider default.
RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_API_KEY=
RAG_MIN_SIMILARITY=0.25

# Lesson 5: ONLY use true when accessing the app through HTTPS, never localhost HTTP.
ADMIN_COOKIE_SECURE=false

# Lesson 6 (switch is explicit; legacy shared KB APIs are disabled when true)
SMARTBIZ_MULTI_TENANT=false
# Inside Docker this is overridden to /data/tenant-uploads
SMARTBIZ_UPLOAD_DIR=./data/tenant-uploads

# Lesson 8: tenant-wide, persisted fixed-window limits. Change carefully after observing usage.
SMARTBIZ_ASK_PER_MINUTE=12
SMARTBIZ_SEARCH_PER_MINUTE=30
SMARTBIZ_UPLOAD_PER_MINUTE=8
